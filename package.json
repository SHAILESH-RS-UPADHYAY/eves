{
  "name": "eves",
  "version": "1.0.0",
  "description": "EVES — Meeting Intelligence Dashboard",
  "main": "out/main/index.js",
  "scripts": {
    "start": "node launcher/runner.js",
    "dashboard": "node launcher/runner.js --dashboard",
    "dev": "electron-vite dev -c eves.config.ts",
    "build": "electron-vite build -c eves.config.ts",
    "package": "npm run build && electron-builder --config packager.yml",
    "preview": "electron-vite preview -c eves.config.ts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON core/utils/audioUrl.test.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON core/utils/llm.test.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON core/utils/brain.test.mts"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.6.0",
    "clsx": "^2.1.1",
    "conf": "^10.2.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.447.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.9",
    "react-hotkeys-hook": "^4.5.1",
    "recharts": "^2.12.0",
    "wavesurfer.js": "^7.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
